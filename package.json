{
  "name": "frameworthy_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-frameworthy-rules-test --only firestore \"vitest run --config vitest.rules.config.js\"",
    "test:functions": "npm --prefix functions test",
    "generate:pricing": "node scripts/generate-pricing-data.mjs",
    "test:all": "npm run test && npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@emailjs/browser": "^4.4.1",
    "@google/model-viewer": "^4.3.1",
    "autoprefixer": "^10.4.22",
    "firebase": "^12.7.0",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-paystack": "^6.0.0",
    "react-router-dom": "^7.12.0",
    "tailwindcss": "^3.4.18",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.24.0",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
