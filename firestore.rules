rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Hardcoded admin allowlist, matching src/constants/admin.js's
    // ADMIN_EMAILS — keep these two in sync if the admin emails ever change.
    //
    // email_verified is required as defense-in-depth: the app has no signup
    // gate on these specific addresses, so without this check, anyone could
    // self-register with admin@/info@frameworthyco.com via the email/password
    // signup form and get an auth token whose email claim matches the
    // allowlist — Firebase Auth's email claim reflects what an account was
    // registered with, not a proven mailbox. Both real admin accounts sign in
    // via Google, which always sets email_verified: true, so this has no
    // effect on legitimate access.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['admin@frameworthyco.com', 'info@frameworthyco.com'];
    }

    match /orders/{orderId} {
      // Guest checkout has no auth context (see CheckoutPage.jsx's
      // `userId: user ? user.uid : 'guest'`), so a created order can't be
      // tied to a verified identity in that case — this mirrors the app's
      // existing guest-checkout support rather than blocking it. Signed-in
      // users must create orders under their own uid, not someone else's.
      //
      // paymentStatus must start 'pending' — only the verifyPaystackPayment
      // Cloud Function (using the Admin SDK, which bypasses these rules
      // entirely) may flip it to 'paid', after checking with Paystack
      // server-side. Without this, a client could just create an order
      // with paymentStatus: 'paid' baked in and skip payment entirely.
      allow create: if request.resource.data.paymentStatus == 'pending'
                    && ((request.resource.data.userId == 'guest' && request.auth == null)
                        || (request.auth != null && request.resource.data.userId == request.auth.uid));

      // A signed-in user can read their own orders; the admin can read and
      // update every order. Guest orders aren't individually re-readable
      // (no identity to check against) — the app already shows a guest's
      // order details from local state right after checkout, not by
      // re-querying Firestore.
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /clientErrors/{errorId} {
      // Written by src/services/errorLogging.js from any client, signed in
      // or not — an error can happen before/without auth, so this can't
      // require request.auth. Size caps mirror the client-side truncation
      // in errorLogging.js and exist so a malicious client can't write
      // arbitrarily large documents. Only the admin reads these back (via
      // the Firebase console or a future debug view) — no client needs to
      // read its own error reports.
      allow create: if request.resource.data.message is string && request.resource.data.message.size() <= 1000
                    && (!('stack' in request.resource.data) || request.resource.data.stack == null || (request.resource.data.stack is string && request.resource.data.stack.size() <= 4000))
                    && (!('componentStack' in request.resource.data) || request.resource.data.componentStack == null || (request.resource.data.componentStack is string && request.resource.data.componentStack.size() <= 4000))
                    && request.resource.data.url is string && request.resource.data.url.size() <= 500
                    && request.resource.data.platform is string;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /chats/{uid} {
      // One thread per customer, doc ID = their own Firebase Auth uid — the
      // customer can read/write only their own thread, the admin can
      // read/write every thread. Messages are immutable once created (no
      // update/delete) since this is a chat log, not editable content.
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());

      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

        // Without checking senderRole/senderId, the thread owner's `create`
        // access (needed for their own messages) also let them write a
        // message claiming senderRole: 'admin' straight into their own
        // thread — fabricated "admin" replies (e.g. a fake refund approval)
        // that render identically to a real one in both ChatFloater.jsx and
        // AdminMessagesPage.jsx. Pin each role to the identity that's
        // actually allowed to produce it, and cap text length (previously
        // unbounded) to a Firestore-doc-appropriate size.
        //
        // senderRole: 'assistant' is necessarily writable by the thread
        // owner too — chat.js's triggerAiResponse() posts the AI's reply
        // from the *customer's own browser session* after calling
        // askSupportAgent, there's no server-side write path for it today.
        // That's a real, narrower residual gap (a customer could locally
        // fabricate an assistant-looking reply) that would need moving the
        // AI response write into the askSupportAgent Cloud Function itself
        // to close — out of scope here, where the concrete risk being
        // fixed is impersonating admin/staff, not the bot.
        allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 4000
                      && (
                        (request.auth != null && request.auth.uid == uid
                          && request.resource.data.senderRole in ['customer', 'assistant']
                          && ((request.resource.data.senderRole == 'customer' && request.resource.data.senderId == request.auth.uid)
                              || (request.resource.data.senderRole == 'assistant' && request.resource.data.senderId == 'ai-assistant')))
                        || (isAdmin() && request.resource.data.senderRole == 'admin' && request.resource.data.senderId == 'admin')
                      );

        allow update, delete: if false;
      }
    }

    // `paystackReferences/{reference}` is written only by verifyPaystackPayment
    // via the Admin SDK (which bypasses these rules entirely) to atomically
    // claim a payment reference against exactly one order, preventing the
    // same reference from being replayed to mark other orders paid. No
    // client ever needs to read or write it directly, so it stays covered
    // by the default-deny below along with everything else not in active
    // use (the `projects` write path in db.js has no caller anywhere in the app).
  }
}
