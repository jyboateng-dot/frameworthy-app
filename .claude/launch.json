{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frameworthy-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "frameworkthy-app-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frameworkthy-app"
      ],
      "port": 3000
    },
    {
      "name": "frameworthy-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    }
  ]
}
