{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/museum-artworks",
        "function": { "functionId": "museumArtworks", "region": "us-central1" }
      },
      {
        "source": "/api/archival-artworks",
        "function": { "functionId": "archivalArtworks", "region": "us-central1" }
      },
      {
        "source": "/api/artic-image",
        "function": {
          "functionId": "proxyArtInstituteImage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/proxy-artwork",
        "function": {
          "functionId": "proxyArtworkImage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/artwork/import-url",
        "function": {
          "functionId": "importArtworkFromUrl",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/prodigi-callback",
        "function": {
          "functionId": "prodigiCallback",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ar-relay",
        "function": {
          "functionId": "arRelay",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ar-relay/**",
        "function": {
          "functionId": "arRelay",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/museum-data/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
